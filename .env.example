# GitHub Identity Bridge - Environment Configuration Template
# Copy this file to .env and fill in your actual values
# DO NOT commit secrets to git - use .env.local or Azure Key Vault in production

# Node Environment
NODE_ENV=development
DEBUG=false
USE_MOCK_OAUTH=true

# Azure AD Configuration (from App Registration)
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
REDIRECT_URI=http://localhost:7071/api/AuthCallback

# GitHub OAuth Configuration (from OAuth App)
GITHUB_OAUTH_CLIENT_ID=your-oauth-client-id
GITHUB_OAUTH_CLIENT_SECRET=your-oauth-client-secret

# GitHub Organization
GITHUB_ORG_NAME=oregonstate-ai
GITHUB_GATEKEEPER_TEAM_SLUG=active-session-users

# GitHub App Configuration (for bot operations)
GITHUB_APP_ID=123456
GITHUB_APP_INSTALLATION_ID=99999999
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEpAIBAAKCAQEA...\n-----END RSA PRIVATE KEY-----"
GITHUB_APP_WEBHOOK_SECRET=your-webhook-secret

# Azure Storage
AzureWebJobsStorage=DefaultEndpointsProtocol=https;AccountName=youraccountname;AccountKey=yourkey;EndpointSuffix=core.windows.net

# Application Insights
APPINSIGHTS_INSTRUMENTATION_KEY=your-instrumentation-key

# Azure Functions Runtime
FUNCTIONS_WORKER_RUNTIME=node
