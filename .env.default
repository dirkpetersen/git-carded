# ============================================================================
# GitHub Identity Bridge - Complete Environment Configuration Template
# ============================================================================
# USAGE:
# - Copy this to .env for local development
# - Fill in values and apply to Azure for production
# - DO NOT commit secrets to git!
# ============================================================================

# ============================================================================
# SECTION 1: Application Mode
# ============================================================================

# Set to "true" for local testing without real OAuth credentials
# Set to "false" for production with real Azure AD + GitHub OAuth
USE_MOCK_OAUTH=true

NODE_ENV=production
DEBUG=false

# ============================================================================
# SECTION 2: Azure AD / Entra ID Configuration
# ============================================================================
# App registration: "github-identity-bridge" in tenant ce6d05e1-3c5e-4d62-87a8-4c4a2713c113
#
# CLI setup (run once):
#   az account set --name "UIT - peterdir sandbox"
#   az ad app create \
#     --display-name "github-identity-bridge" \
#     --sign-in-audience AzureADMyOrg \
#     --web-redirect-uris \
#       "https://github-identity-bridge-app.azurewebsites.net/api/AuthCallback" \
#       "http://localhost:7071/api/AuthCallback"
#   az ad app credential reset --id <appId> --display-name "github-identity-bridge-secret" --years 2

AZURE_TENANT_ID=your-tenant-id-here
# Location: Entra portal → Azure Active Directory → Overview → Tenant ID

AZURE_CLIENT_ID=your-client-id-here
# Location: output of `az ad app create` → appId
# Or: Entra portal → App registrations → github-identity-bridge → Overview → Application (client) ID

AZURE_CLIENT_SECRET=your-client-secret-here
# Location: output of `az ad app credential reset` → password
# ⚠️ Shown only once — copy immediately

REDIRECT_URI=https://github-identity-bridge-app.azurewebsites.net/api/AuthCallback
# Must match exactly (including casing) what is registered in the Entra app registration
# For local dev: http://localhost:7071/api/AuthCallback

# ============================================================================
# SECTION 3: GitHub OAuth App (Account Linking)
# ============================================================================
# Allows users to connect their GitHub account to their OSU identity.
#
# Create at: https://github.com/settings/developers → OAuth Apps → New OAuth App
#   Application name:        github-identity-bridge
#   Homepage URL:            https://github-identity-bridge-app.azurewebsites.net
#   Authorization callback:  https://github-identity-bridge-app.azurewebsites.net/api/AuthCallback

GITHUB_OAUTH_CLIENT_ID=your-github-oauth-client-id-here
# Location: OAuth App page → Client ID

GITHUB_OAUTH_CLIENT_SECRET=your-github-oauth-client-secret-here
# Location: OAuth App page → Generate a new client secret
# ⚠️ Shown only once — copy immediately

# ============================================================================
# SECTION 4: GitHub App (Org Bot)
# ============================================================================
# Service account that manages org and team membership on oregonstate-ai.
#
# Create at: https://github.com/organizations/<your-org>/settings/apps → New GitHub App
#   GitHub App name:  github-identity-bridge
#   Homepage URL:     https://github-identity-bridge-app.azurewebsites.net
#   Webhook URL:      https://github-identity-bridge-app.azurewebsites.net/api/GithubWebhook
#   Webhook secret:   generate with: openssl rand -hex 32
#   Permissions:
#     Organization → Members:      Read & Write
#     Organization → Team members: Read & Write
#   Events: member
#
# After creation:
#   - Generate a Private Key (downloads .pem file)
#   - Install the app on oregonstate-ai
#   - Note the Installation ID from the URL: .../settings/installations/XXXXXXXX

GITHUB_APP_ID=your-github-app-id-here
# Location: GitHub App settings page → App ID

GITHUB_APP_INSTALLATION_ID=your-installation-id-here
# Location: https://github.com/organizations/oregonstate-ai/settings/installations/XXXXXXXX
# The number at the end of that URL is the Installation ID

GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
MIIEpAIBAAKCAQEA...your-full-private-key-here...
-----END RSA PRIVATE KEY-----"
# Paste the entire contents of the downloaded .pem file here
# For Azure deployment (single line): "-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----"
# Apply via CLI: PRIVATE_KEY=$(awk '{printf "%s\\n", $0}' github-identity-bridge.private-key.pem)

GITHUB_APP_WEBHOOK_SECRET=your-random-webhook-secret-here
# Generate with: openssl rand -hex 32
# Must match the webhook secret entered when creating the GitHub App

# ============================================================================
# SECTION 5: GitHub Organization Settings
# ============================================================================

GITHUB_ORG_NAME=your-github-org-name
# The GitHub organization to manage

GITHUB_GATEKEEPER_TEAM_SLUG=active-session-users
# The only team with repository access (default deny model)
# This team must be granted access to: demo-repository
#
# Create team:
#   gh api /orgs/<your-org>/teams -f name='Active-Session-Users' -f privacy='closed'
# Grant repo access:
#   gh api /orgs/<your-org>/teams/active-session-users/repos/<your-org>/<repo-name> \
#     -X PUT -f permission=push

# ============================================================================
# SECTION 6: Azure Storage & Runtime (Auto-Configured by Azure)
# ============================================================================
# Set automatically when the Function App was provisioned — do not set manually.

# AzureWebJobsStorage=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...
# FUNCTIONS_WORKER_RUNTIME=node
# FUNCTIONS_EXTENSION_VERSION=~4
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;

# ============================================================================
# DEPLOYMENT COMMANDS
# ============================================================================
#
# LOCAL TESTING (mock mode — no real credentials needed):
#   cp .env.default .env
#   npm start
#   open http://localhost:7071/api/Login
#
# APPLY SETTINGS TO AZURE (run after filling in values above):
#   az account set --name "<your-azure-subscription>"
#   az functionapp config appsettings set \
#     --name <your-function-app-name> \
#     --resource-group <your-resource-group> \
#     --settings \
#       "USE_MOCK_OAUTH=false" \
#       "AZURE_TENANT_ID=ce6d05e1-3c5e-4d62-87a8-4c4a2713c113" \
#       "AZURE_CLIENT_ID=<value>" \
#       "AZURE_CLIENT_SECRET=<value>" \
#       "GITHUB_OAUTH_CLIENT_ID=<value>" \
#       "GITHUB_OAUTH_CLIENT_SECRET=<value>" \
#       "GITHUB_APP_ID=<value>" \
#       "GITHUB_APP_INSTALLATION_ID=<value>" \
#       "GITHUB_APP_WEBHOOK_SECRET=<value>" \
#       "GITHUB_APP_PRIVATE_KEY=<single-line-value>"
#
# DEPLOY CODE:
#   func azure functionapp publish <your-function-app-name>
#
# ============================================================================
