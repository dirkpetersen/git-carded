# ============================================================================
# GitHub Identity Bridge - Complete Environment Configuration Template
# ============================================================================
# This file contains ALL environment variables needed for both:
# - Local development (USE_MOCK_OAUTH=true)
# - Production deployment (USE_MOCK_OAUTH=false)
#
# USAGE:
# - Copy this to .env for local development
# - Fill in values and apply to Azure for production
# - DO NOT commit secrets to git!
# ============================================================================

# ============================================================================
# SECTION 1: Application Mode
# ============================================================================

# Set to "true" for local testing without real OAuth credentials
# Set to "false" for production with real Azure AD + GitHub OAuth
USE_MOCK_OAUTH=true

# Environment mode
NODE_ENV=production

# Debug logging (set to "true" for verbose output)
DEBUG=false

# ============================================================================
# SECTION 2: Azure AD Configuration (for Corporate SSO Authentication)
# ============================================================================
# These credentials allow users to log in with their corporate Azure AD accounts.
#
# HOW TO GET THESE:
# 1. Go to: https://portal.azure.com
# 2. Navigate: Azure Active Directory → App registrations
# 3. Click: "New registration" or select existing "github-identity-bridge"
# 4. Fill in:
#    - Name: github-identity-bridge
#    - Supported account types: Single tenant
#    - Redirect URI: https://github-identity-bridge-app.azurewebsites.net/api/authcallback
# 5. After creation, copy the values from the Overview page:

AZURE_TENANT_ID=your-tenant-id-here
# Location: App registration → Overview → Directory (tenant) ID
# Example: a1b2c3d4-e5f6-7890-abcd-ef1234567890

AZURE_CLIENT_ID=your-client-id-here
# Location: App registration → Overview → Application (client) ID
# Example: 12345678-abcd-1234-abcd-1234567890ab

AZURE_CLIENT_SECRET=your-client-secret-here
# Location: App registration → Certificates & secrets → Client secrets → New client secret
# ⚠️ IMPORTANT: Copy the VALUE immediately after creating - it won't be shown again!
# Example: abc123~XYZ789-aBcDeFgHiJkLmNoPqRsTuVwXyZ

# Redirect URI for OAuth callback
REDIRECT_URI=https://github-identity-bridge-app.azurewebsites.net/api/authcallback

# ============================================================================
# SECTION 3: GitHub OAuth App (for Linking GitHub Accounts)
# ============================================================================
# This allows users to connect their GitHub accounts to their corporate identity.
#
# HOW TO GET THESE:
# 1. Go to: https://github.com/settings/developers
# 2. Click: "OAuth Apps" → "New OAuth App"
# 3. Fill in:
#    - Application name: github-identity-bridge
#    - Homepage URL: https://github-identity-bridge-app.azurewebsites.net
#    - Authorization callback URL: https://github-identity-bridge-app.azurewebsites.net/api/authcallback
# 4. After creation, copy:

GITHUB_OAUTH_CLIENT_ID=your-github-oauth-client-id-here
# Location: OAuth Apps page → Client ID
# Example: Iv1.a1b2c3d4e5f67890

GITHUB_OAUTH_CLIENT_SECRET=your-github-oauth-client-secret-here
# Location: OAuth Apps page → "Generate a new client secret"
# ⚠️ IMPORTANT: Copy immediately - shown only once!
# Example: 1234567890abcdef1234567890abcdef12345678

# ============================================================================
# SECTION 4: GitHub App (for Bot Operations)
# ============================================================================
# This gives the system permission to manage organization and team memberships.
#
# HOW TO CREATE THE GITHUB APP:
# 1. Go to: https://github.com/organizations/YourOrganization/settings/apps
# 2. Click: "New GitHub App"
# 3. Fill in:
#    - GitHub App name: github-identity-bridge
#    - Homepage URL: https://github-identity-bridge-app.azurewebsites.net
#    - Webhook URL: https://github-identity-bridge-app.azurewebsites.net/api/githubwebhook
#    - Webhook secret: Generate a random string (keep it for later)
# 4. Set permissions:
#    - Organization permissions:
#      • Members: Read & Write
#      • Team members: Read & Write
#      • Teams: Read & Write
# 5. Subscribe to webhook events:
#    - member (when user added/removed from org)
# 6. Click "Create GitHub App"
# 7. After creation:
#    - Generate a private key (downloads .pem file)
#    - Install the app on YourOrganization organization
#    - Note the Installation ID from the URL after installation

GITHUB_APP_ID=123456
# Location: GitHub App settings page → App ID (displayed at top)
# Example: 123456

GITHUB_APP_INSTALLATION_ID=99999999
# Location: After installing app, check URL:
# https://github.com/organizations/YourOrganization/settings/installations/XXXXXX
# The number XXXXXX is your Installation ID
# Example: 12345678

GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
MIIEpAIBAAKCAQEA...your-full-private-key-here...
-----END RSA PRIVATE KEY-----"
# Location: GitHub App settings → Private keys → Generate a private key
# This downloads a .pem file. Paste the ENTIRE contents here (including BEGIN/END lines)
# ⚠️ For Azure deployment: You may need to escape newlines as \n or use Azure Key Vault
# Example format for Azure (single line):
# "-----BEGIN RSA PRIVATE KEY-----\nMIIEpAIBAAK...\n-----END RSA PRIVATE KEY-----"

GITHUB_APP_WEBHOOK_SECRET=your-random-webhook-secret-here
# This is the webhook secret you created when setting up the GitHub App
# Generate a strong random string: openssl rand -hex 32
# Example: a1b2c3d4e5f6789012345678901234567890abcdef1234567890abcdef123456

# ============================================================================
# SECTION 5: GitHub Organization Settings
# ============================================================================

GITHUB_ORG_NAME=YourOrganization
# The GitHub organization to manage

GITHUB_GATEKEEPER_TEAM_SLUG=active-session-users
# The team that grants repository access
# IMPORTANT: Create this team first:
# gh api /orgs/YourOrganization/teams -f name='Active-Session-Users' -f privacy='closed'
# Then grant this team access to your repositories

# ============================================================================
# SECTION 6: Azure Storage & Runtime (Auto-Configured by Azure)
# ============================================================================
# These are automatically set when you create the Function App.
# You typically don't need to set these manually.

# AzureWebJobsStorage=DefaultEndpointsProtocol=https;AccountName=ghidbridgeelvtn5wpwujr2;AccountKey=...
# FUNCTIONS_WORKER_RUNTIME=node
# FUNCTIONS_EXTENSION_VERSION=~4
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...
# WEBSITE_RUN_FROM_PACKAGE=1

# ============================================================================
# DEPLOYMENT COMMANDS
# ============================================================================
#
# LOCAL TESTING:
# 1. Copy this file: cp .env.default .env
# 2. Set USE_MOCK_OAUTH=true (no real credentials needed)
# 3. Run: func start
# 4. Test: http://localhost:7071/api/login
#
# AZURE PRODUCTION:
# 1. Fill in all credential values above
# 2. Apply settings:
#    az functionapp config appsettings set \
#      --name github-identity-bridge-app \
#      --resource-group github-identity-bridge-rg \
#      --settings \
#        "USE_MOCK_OAUTH=false" \
#        "AZURE_TENANT_ID=your-value" \
#        "AZURE_CLIENT_ID=your-value" \
#        (etc... paste each setting individually)
# 3. Deploy code:
#    func azure functionapp publish github-identity-bridge-app
#
# ============================================================================
